# Content Hub (CP / strong consistency). Não é escopado por project.
# As rotas de escrita/admin têm o middleware de Authorization comentado hoje,
# então nenhuma exige token. Quirks reais da API:
#   - a listagem fica em /contenthubs (plural)
#   - GET/DELETE /contenthub/{key} leem a chave do query ?key= (não do path);
#     só /contenthub/sdk/{key} usa o valor do path.

### Cria/atualiza um conteúdo
PATCH {{host}}/contenthub
Accept: application/json
Content-Type: application/json

{
  "key": "homepage_banner",
  "value": "enabled",
  "description": "Main homepage banner with weighted distribution",
  "active": true,
  "created_at": "2024-01-15T10:30:00Z",
  "session_strategy": [
    {
      "session_id": "session-primers-123",
      "response": {
        "id": "promo-black-friday",
        "title": "Black Friday - Primers 50% OFF",
        "content": "Take advantage of our Black Friday deals!",
        "ctaText": "Shop Now",
        "ctaUrl": "https://example.com/promo/black-friday"
      }
    },
    {
      "session_id": "default",
      "response": {
        "id": "promo-black-friday",
        "title": "Stay tuned for promotions",
        "content": "Don't miss out on our Black Friday deals!",
        "ctaText": "Shop Now",
        "ctaUrl": "https://example.com/promo/black-friday"
      }
    }
  ],
  "balancer_strategy": [
    {
      "weight": 50,
      "response": {
        "id": "promo-black-friday",
        "title": "Black Friday - 50% OFF",
        "content": "Take advantage of our Black Friday deals!",
        "ctaText": "Shop Now",
        "ctaUrl": "https://example.com/promo/black-friday"
      }
    },
    {
      "weight": 50,
      "response": {
        "id": "seasonal-collection",
        "title": "New Seasonal Collection",
        "content": "Discover the latest trends of the season",
        "ctaText": "View Collection",
        "ctaUrl": "https://example.com/collections/seasonal"
      }
    }
  ]
}


### Lista todos os conteúdos (note o plural: /contenthubs)
GET {{host}}/contenthubs
Accept: application/json


### Busca um conteúdo (a chave vem do query ?key=)
GET {{host}}/contenthub/homepage_banner?key=homepage_banner
Accept: application/json


### Leitura via SDK (a chave vem do path)
GET {{host}}/contenthub/sdk/homepage_banner
Accept: application/json


### Remove um conteúdo (a chave vem do query ?key=)
DELETE {{host}}/contenthub/homepage_banner?key=homepage_banner
Accept: application/json
