export SDK_CLIENT_AT="secret"
export MONGODB_URI="mongodb://admin:password@localhost:27017"
export MONGODB_NAME="featureflag"
export MONGODB_IDX_TIMEOUT="1s"
export REPOSITORY_TYPE="mongodb"
# Só é lida no boot se a coleção/arquivo de usuários estiver vazio (spec 003 §4.2).
# Gere o hash com bcrypt (custo 10) e escape os "$" com "\$" neste arquivo shell.
export ADMIN_USERS="admin@example.com:\$2a\$10\$replace-with-a-real-bcrypt-hash"